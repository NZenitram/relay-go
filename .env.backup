# Redis Configuration (using port 6381)
REDIS_HOST=localhost:6381

# AWS Configuration
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=dummy
# AWS_SECRET_ACCESS_KEY=dummy

# S3 Configuration
S3_BUCKET_NAME=test-webhook-events

# DynamoDB Configuration
DYNAMODB_ENDPOINT=http://localhost:8000

# Development Mode (logs S3 operations instead of uploading)
DEV_MODE=true

# HTTP Server
HTTP_SERVER_PORT=8888

# Dummy Kafka values (will fail and trigger light mode)
KAFKA_BROKERS=dummy:9092
EMAIL_TOPIC=emails
WEBHOOK_TOPIC_SENDGRID=webhook-sendgrid
WEBHOOK_TOPIC_SPARKPOST=webhook-sparkpost
WEBHOOK_TOPIC_POSTMARK=webhook-postmark
WEBHOOK_TOPIC_SOCKETLABS=webhook-socketlabs
WEBHOOK_TOPIC_MANDRILL=webhook-mandrill
WEBHOOK_TOPIC_RESEND=webhook-resend

# Don't set MySQL variables to force light mode